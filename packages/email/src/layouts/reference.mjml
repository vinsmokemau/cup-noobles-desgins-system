<mjml lang="es-MX">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="$cn(font.family.body)" />
      <mj-text
        font-size="$cn(font.size.body)"
        line-height="$cn(font.lineHeight.body)"
        font-weight="$cn(font.weight.body)"
        color="$cn(color.text.default)"
        padding="$cn(space.base)"
        container-background-color="$cn(color.bg.base)"
      />
    </mj-attributes>
  </mj-head>
  <mj-body width="$cn(layout.email.width.max)" background-color="$cn(color.bg.base)">
    <mj-include path="../components/header.mjml" />
    <mj-include path="../components/content-section.mjml" />
    <mj-include path="../components/card.mjml" />
    <mj-include path="../components/button.mjml" />
    <mj-include path="../components/divider.mjml" />
    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>

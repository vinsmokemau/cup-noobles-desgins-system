<mjml lang="es-MX">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="$cn(font.family.body)" />
      <mj-text
        font-size="$cn(font.size.body)"
        line-height="$cn(font.lineHeight.body)"
        font-weight="$cn(font.weight.body)"
        color="$cn(color.text.default)"
        padding="$cn(space.md)"
        container-background-color="$cn(color.bg.base)"
      />
    </mj-attributes>
  </mj-head>
  <mj-body width="$cn(layout.email.width.max)" background-color="$cn(color.bg.base)">
    <mj-section background-color="$cn(color.bg.base)" padding="$cn(space.md)">
      <mj-column background-color="$cn(color.bg.base)">
        <mj-text
          ><h2
            style="
              margin: 0;
              font-family: $cn(font.h2.family);
              font-size: $cn(font.h2.size);
              font-weight: $cn(font.h2.weight);
              line-height: $cn(font.h2.lineHeight);
              color: $cn(color.text.default);
            "
          >
            {{ heading }}
          </h2></mj-text
        >
        <mj-text>{{ body }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

<mjml lang="es-MX">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="$cn(font.family.body)" />
      <mj-text
        font-size="$cn(font.size.body)"
        line-height="$cn(font.lineHeight.body)"
        font-weight="$cn(font.weight.body)"
        color="$cn(color.text.default)"
        padding="$cn(space.base)"
        container-background-color="$cn(color.bg.base)"
      />
    </mj-attributes>
  </mj-head>
  <mj-body width="$cn(layout.email.width.max)" background-color="$cn(color.bg.base)">
    <mj-section
      background-color="$cn(siteFooter.bg)"
      border-top="$cn(border.width.siteFooter) solid $cn(siteFooter.line)"
      padding="$cn(space.base)"
    >
      <mj-column background-color="$cn(siteFooter.bg)">
        <mj-text
          align="center"
          color="$cn(siteFooter.fg)"
          font-size="$cn(font.size.caption)"
          line-height="$cn(font.lineHeight.caption)"
          container-background-color="$cn(siteFooter.bg)"
          >{{ footer_text }}</mj-text
        >
        <mj-text
          align="center"
          color="$cn(siteFooter.fg)"
          font-size="$cn(font.size.caption)"
          line-height="$cn(font.lineHeight.caption)"
          container-background-color="$cn(siteFooter.bg)"
          ><a href="{{ footer_link_url }}" style="color: $cn(link.fg)">{{ footer_link_label }}</a></mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

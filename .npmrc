# T12.1 (OD-03): the @vinsmokemau packages live on GitHub Packages, and the consumer fixture installs them from there.
# The token is not in this file. It goes in the user-level ~/.npmrc (see docs/00-overview/using-the-system.md):
#   //npm.pkg.github.com/:_authToken=<a token with read:packages>
# CI gets the token from actions/setup-node and the workflow's GITHUB_TOKEN.
@vinsmokemau:registry=https://npm.pkg.github.com

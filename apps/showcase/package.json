{
  "name": "showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/clean-content-cache.mjs && nuxt generate",
    "test:e2e": "playwright test",
    "test:deployed": "playwright test --config playwright.deployed.config.ts",
    "test:visual:update": "playwright test --project=visual-360 --project=visual-768 --project=visual-1280 --update-snapshots"
  },
  "dependencies": {
    "@nuxt/content": "3.16.1",
    "@vinsmokemau/cup-noobles-nuxt": "workspace:*",
    "nuxt": "4.5.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}

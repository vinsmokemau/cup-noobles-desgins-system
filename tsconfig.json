{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.vue"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.nuxt", "**/.output", "tests/fixtures"]
}

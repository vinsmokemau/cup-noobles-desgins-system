{
  "name": "cup-noobles-desgins-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:format && pnpm lint:md",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write . && markdownlint-cli2 --fix",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "check:docs": "node scripts/check-docs.ts && pnpm check:links",
    "check:links": "node scripts/check-links.ts",
    "check:tbd": "node scripts/check-tbd.ts",
    "check:tokens": "node scripts/check-tokens.ts && node scripts/check-contrast.ts",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:docs && pnpm check:tokens && pnpm check:tbd",
    "build:tokens": "pnpm --filter @vinsmokemau/cup-noobles-tokens build",
    "test:all": "pnpm test && pnpm build:tokens"
  },
  "devDependencies": {
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.1"
  }
}

{
  "name": "cup-noobles-desgins-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:format && pnpm lint:md && pnpm lint:email",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:email": "node packages/email/build.ts --lint",
    "format": "prettier --write . && markdownlint-cli2 --fix",
    "typecheck": "pnpm check:tbd && vue-tsc --noEmit",
    "test:unit": "vitest run",
    "check:docs": "node scripts/check-docs.ts && pnpm check:links",
    "check:links": "node scripts/check-links.ts",
    "check:tbd": "node scripts/check-tbd.ts",
    "release:check": "node scripts/release-check.ts",
    "check:tokens": "node scripts/check-tokens.ts && node scripts/check-contrast.ts",
    "sync:docs": "node scripts/sync-docs.ts",
    "changeset": "changeset",
    "version-packages": "node scripts/version-packages.ts",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:docs && pnpm check:tokens && pnpm check:tbd && pnpm sync:docs --check",
    "build:tokens": "pnpm --filter @vinsmokemau/cup-noobles-tokens build",
    "build:email": "pnpm --filter @vinsmokemau/cup-noobles-email build",
    "build:nuxt": "pnpm --filter @vinsmokemau/cup-noobles-nuxt build",
    "build:fixture": "pnpm --filter consumer-fixture build",
    "build:showcase": "pnpm --filter showcase generate",
    "test:e2e": "pnpm --filter consumer-fixture test:e2e && pnpm --filter showcase test:e2e",
    "test:visual:update": "pnpm --filter showcase test:visual:update",
    "test:all": "pnpm test && pnpm build:tokens && pnpm build:email && pnpm build:nuxt && pnpm build:fixture && pnpm build:showcase && pnpm test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.1"
  }
}

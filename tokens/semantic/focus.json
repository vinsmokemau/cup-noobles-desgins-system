{
  "focus": {
    "ring": {
      "color": {
        "$type": "color",
        "$value": "{color.brand.yellow}",
        "$description": "Focus indicator color: brand yellow (BR-02), separated from the component by the offset gap so it only touches the container background. It must differ from the glow (REQ-024, ADR-0009).",
        "$extensions": { "cn": { "status": "stable" } }
      },
      "width": {
        "$type": "dimension",
        "$value": "{focus.width.default}",
        "$description": "Focus indicator width (ADR-0009).",
        "$extensions": { "cn": { "status": "stable" } }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{focus.offset.default}",
        "$description": "Focus indicator offset: the gap between the component and the ring (ADR-0009).",
        "$extensions": { "cn": { "status": "stable" } }
      },
      "style": {
        "$type": "strokeStyle",
        "$value": "{focus.style.default}",
        "$description": "Focus indicator line style (ADR-0009).",
        "$extensions": { "cn": { "status": "stable" } }
      }
    }
  }
}

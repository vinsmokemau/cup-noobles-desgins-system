{
  "layout": {
    "container": {
      "max": {
        "$type": "dimension",
        "$value": "{container.max}",
        "$description": "Maximum content container width, 1280 px (ADR-0035, TBD-13). The 360 px minimum is ER-05.",
        "$extensions": { "cn": { "status": "stable", "source": "ADR-0035" } }
      }
    },
    "logo": {
      "clearSpace": {
        "$type": "number",
        "$value": "{logo.rule.clearSpace}",
        "$description": "Clear space around a logo, as a share of its height (ADR-0016).",
        "$extensions": { "cn": { "status": "stable" } }
      },
      "minHeight": {
        "icon": {
          "$type": "dimension",
          "$value": "{logo.rule.minHeight.icon}",
          "$description": "Minimum height of the icon logo (ADR-0016).",
          "$extensions": { "cn": { "status": "stable" } }
        },
        "vertical": {
          "$type": "dimension",
          "$value": "{logo.rule.minHeight.vertical}",
          "$description": "Minimum height of the vertical lockup (ADR-0016).",
          "$extensions": { "cn": { "status": "stable" } }
        },
        "horizontal": {
          "$type": "dimension",
          "$value": "{logo.rule.minHeight.horizontal}",
          "$description": "Minimum height of the horizontal wordmark (ADR-0016).",
          "$extensions": { "cn": { "status": "stable" } }
        }
      }
    }
  }
}

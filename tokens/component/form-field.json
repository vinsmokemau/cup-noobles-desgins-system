{
  "formField": {
    "label": {
      "fg": {
        "$type": "color",
        "$value": "{color.text.default}",
        "$description": "Label text of a form field.",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "description": {
      "fg": {
        "$type": "color",
        "$value": "{color.text.muted}",
        "$description": "Description and hint text of a form field.",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "help": {
      "fg": {
        "$type": "color",
        "$value": "{color.text.muted}",
        "$description": "Help text under a form field.",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "error": {
      "fg": {
        "$type": "color",
        "$value": "{color.feedback.error}",
        "$description": "Error message under a form field.",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    }
  }
}

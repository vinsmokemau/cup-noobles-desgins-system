{
  "radius": {
    "alert": {
      "$type": "dimension",
      "$value": "{radius.interactive}",
      "$description": "Corner radius of the alert. TBD-10: \"rounded\" has no values; this follows a placeholder, not a brand value.",
      "$extensions": {
        "cn": {
          "status": "tbd",
          "tbd": ["TBD-10"]
        }
      }
    }
  },
  "border": {
    "width": {
      "alert": {
        "$type": "dimension",
        "$value": "{border.width.interactive}",
        "$description": "Outline stroke width of the alert (BR-13).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    }
  },
  "alert": {
    "bg": {
      "$type": "color",
      "$value": "{color.bg.base}",
      "$description": "Fill of the alert: the pure black page (BR-03). The look is an outline, not a fill (ADR-0027).",
      "$extensions": {
        "cn": {
          "status": "stable"
        }
      }
    },
    "fg": {
      "$type": "color",
      "$value": "{color.text.default}",
      "$description": "Title text of the alert.",
      "$extensions": {
        "cn": {
          "status": "stable"
        }
      }
    },
    "fgMuted": {
      "$type": "color",
      "$value": "{color.text.muted}",
      "$description": "Description text of the alert.",
      "$extensions": {
        "cn": {
          "status": "stable"
        }
      }
    },
    "success": {
      "color": {
        "$type": "color",
        "$value": "{color.feedback.success}",
        "$description": "Outline and icon color of a success alert (ADR-0027).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "info": {
      "color": {
        "$type": "color",
        "$value": "{color.feedback.info}",
        "$description": "Outline and icon color of a info alert (ADR-0027).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "warning": {
      "color": {
        "$type": "color",
        "$value": "{color.feedback.warning}",
        "$description": "Outline and icon color of a warning alert (ADR-0027).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "error": {
      "color": {
        "$type": "color",
        "$value": "{color.feedback.error}",
        "$description": "Outline and icon color of a error alert (ADR-0027).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    },
    "focus": {
      "color": {
        "$type": "color",
        "$value": "{focus.ring.color}",
        "$description": "Focus ring color of the alert close button (REQ-024 AC1, ADR-0009).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      },
      "width": {
        "$type": "dimension",
        "$value": "{focus.ring.width}",
        "$description": "Focus ring width of the alert close button (REQ-024 AC1, ADR-0009).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{focus.ring.offset}",
        "$description": "Gap between the alert close button and its focus ring (REQ-024 AC1, ADR-0009).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      },
      "style": {
        "$type": "strokeStyle",
        "$value": "{focus.ring.style}",
        "$description": "Focus ring line style of the alert close button (REQ-024 AC1, ADR-0009).",
        "$extensions": {
          "cn": {
            "status": "stable"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vinsmokemau/cup-noobles-desgins-system/docs/_schema/frontmatter.schema.json",
  "title": "Cup Noobles doc frontmatter",
  "description": "Frontmatter of every doc in docs/ (SPEC.md §4.3, REQ-002). Exempt: docs/_template.md and docs/00-overview/brand-context-source.md.",
  "type": "object",
  "required": ["title", "slug", "layer", "status", "lang", "since", "updated"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "description": "Also the doc's H1 (§4.2).",
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "description": "Unique, kebab-case; also the showcase route segment.",
      "$ref": "#/$defs/slug"
    },
    "layer": {
      "enum": ["overview", "foundation", "component", "pattern", "content", "email", "governance", "adr"]
    },
    "level": {
      "description": "Component docs only (REQ-002 AC3).",
      "enum": ["atom", "molecule", "organism"]
    },
    "source": {
      "description": "Component docs only (REQ-002 AC3).",
      "enum": ["nuxt-ui", "custom"]
    },
    "nuxtUi": {
      "description": "The Nuxt UI component name. Required when source is nuxt-ui.",
      "type": ["string", "null"],
      "pattern": "^U[A-Z][A-Za-z0-9]*$"
    },
    "component": {
      "description": "The custom component name (REQ-021). Required when source is custom.",
      "type": ["string", "null"],
      "pattern": "^Cn[A-Z][A-Za-z0-9]*$"
    },
    "status": {
      "description": "REQ-002 AC2.",
      "enum": ["tbd", "draft", "stable", "deprecated"]
    },
    "lang": {
      "description": "REQ-007 AC1.",
      "const": "en"
    },
    "brandRules": {
      "description": "BR IDs implemented (SPEC.md §2.1); may be empty.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^BR-[0-9]{2}$" }
    },
    "tokens": {
      "description": "Token path prefixes rendered in generated blocks (§4.5).",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9-]+)*$" }
    },
    "demos": {
      "description": "Component and pattern docs only; files in apps/showcase/demos/<slug>/.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "tbd": {
      "description": "TBD IDs (SPEC.md §2.4).",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TBD-[0-9]{2,}$" }
    },
    "related": {
      "description": "Slugs of related docs.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "since": {
      "description": "The package version that introduced the doc.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "updated": {
      "description": "ISO date (YYYY-MM-DD).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "component" } }, "required": ["layer"] },
      "then": { "required": ["level", "source"] },
      "else": {
        "properties": {
          "level": false,
          "source": false,
          "nuxtUi": false,
          "component": false
        }
      }
    },
    {
      "if": { "properties": { "source": { "const": "nuxt-ui" } }, "required": ["source"] },
      "then": {
        "required": ["nuxtUi"],
        "properties": { "nuxtUi": { "type": "string" } }
      }
    },
    {
      "if": { "properties": { "source": { "const": "custom" } }, "required": ["source"] },
      "then": {
        "required": ["component"],
        "properties": { "component": { "type": "string" } }
      }
    },
    {
      "if": { "properties": { "layer": { "enum": ["component", "pattern"] } }, "required": ["layer"] },
      "else": { "properties": { "demos": false } }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
